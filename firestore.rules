rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      match /tasks/{taskId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.id == taskId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 150
          && request.resource.data.date is string
          && request.resource.data.category in ['company', 'personal']
          && request.resource.data.kind in ['todo', 'event']
          && request.resource.data.status in ['planned', 'progress', 'done'];
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
